  m_text: "<b><color=#9EDC8C>Your goal</color></b>\nProtect the forest! Stop the
    tree cutters, help the people you meet with their quests, earn coins, buy seeds
    and plant new trees.\n\n<b><color=#9EDC8C>Controls</color></b>\n<b>W A S D</b> 
    \u2013  move<pos=50%><b>Mouse</b>  \u2013  look around\n<b>Shift</b>  \u2013 
    run<pos=50%><b>Ctrl</b>  \u2013  crouch\n<b>Space</b>  \u2013  jump<pos=50%><b>Left
    click</b>  \u2013  cast a fireball\n<b>E</b>  \u2013  talk / interact<pos=50%><b>F</b> 
    \u2013  plant a seed\n<b>I</b>  \u2013  open the book<pos=50%><b>V</b>  \u2013 
    first / third person\n<b>Esc</b>  \u2013  pause menu"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
